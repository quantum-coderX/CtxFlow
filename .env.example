# PostgreSQL connection settings
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ctxflow
DB_USER=your_user
DB_PASSWORD=your_password

# Optional Groq provider for LLM extraction and edge proposals
# GROQ_API_KEY=your_groq_api_key

# ResearchOS model gateway (optional; disabled by default)
# Provider choices: groq | ollama | nvidia | openrouter | hf
# RESEARCHOS_MODEL_ENABLED=1
# RESEARCHOS_MODEL_PROVIDER=groq
# RESEARCHOS_MODEL_ID=openai/gpt-oss-20b
# RESEARCHOS_MODEL_TIMEOUT_S=20
# RESEARCHOS_MAX_RETRIES=2
# Optional self-hosted/proxy overrides:
# RESEARCHOS_MODEL_BASE_URL=
# RESEARCHOS_MODEL_API_KEY=

# Parallel research (all optional)
# Web search is opt-in and is also disabled by RESEARCHOS_EXTERNAL_SEARCH=off.
# RESEARCHOS_WEB_SEARCH=on
# RESEARCHOS_LLM_PLANNING=1
# RESEARCHOS_MAX_WORKERS=2
# RESEARCHOS_MAX_FETCHED_PAGES=4

# Docker Compose (docker compose up --build)
# DB_PASSWORD is required by compose; DB_HOST is set to the db service automatically.
# API_PORT=8000
# INSTALL_LAYA=true                 # build arg; false = smaller image, heuristic selector
# INSTALL_LOCAL_EMBEDDINGS=false    # build arg; true bundles sentence-transformers (BGE)
# RESEARCHOS_MEMORY_ENABLED=true
# RESEARCHOS_GRAPH_BACKEND=postgres # json (default outside compose) | postgres; needs migration 006
# LAYA_CONTEXT_SELECTION=false
# LAYA_TIERING=false                # Laya tier proposals on /api/memory/page?advise=true
# Local models: docker compose --profile ollama up, then
# RESEARCHOS_MODEL_ENABLED=1
# RESEARCHOS_MODEL_PROVIDER=ollama
# RESEARCHOS_MODEL_BASE_URL=http://ollama:11434/v1
